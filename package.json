{
  "name": "disk-analyzer",
  "productName": "Analisador de Disco",
  "version": "1.0.1",
  "private": true,
  "description": "Shows what is using your disk and finds programs that Windows does not list.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JvTadeo/disk-sleuth.git"
  },
  "homepage": "https://github.com/JvTadeo/disk-sleuth",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:setup": "electron-vite build && electron-builder --win nsis",
    "dist:portable": "electron-vite build && electron-builder --win portable",
    "test:detector": "rolldown tests/classify.test.ts --platform node --format esm -o out/tests/classify.test.mjs --log-level silent && node out/tests/classify.test.mjs",
    "test:report": "rolldown tests/report.test.ts --platform node --format esm -o out/tests/report.test.mjs --log-level silent && node out/tests/report.test.mjs",
    "test:scanner": "rolldown tests/scanner.test.ts --platform node --format esm -o out/tests/scanner.test.mjs --log-level silent && node out/tests/scanner.test.mjs",
    "bench": "electron-vite build --logLevel warn && node out/main/bench.js"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "zustand": "^5.1.0"
  },
  "author": "Analisador de Disco"
}
